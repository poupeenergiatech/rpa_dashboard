# Copie para .env e preencha com os valores reais.

ALLPFIT_EMAIL=
ALLPFIT_PASSWORD=

# autenticar o POST em /api/webhooks/scans (header Authorization: Bearer <secret>).
# Independente de AGREGADOR_WEBHOOK_SECRET -- não reusar o mesmo valor.
SCANS_WEBHOOK_SECRET=

# URL de destino do webhook.
# Teste local: http://localhost:8787/api/webhooks/scans
SCANS_WEBHOOK_URL=
